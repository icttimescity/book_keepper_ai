# Agnes AI
AGNES_API_KEY=your_agnes_api_key
AGNES_API_URL=https://apihub.agnes-ai.com/v1/chat/completions
AGNES_MODEL=agnes-2.5-flash

# Supabase - primary book database
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_TIMEOUT_MS=6000

# Supabase server-only key for /admin CRUD, manager login and import
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Main admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=change-me
